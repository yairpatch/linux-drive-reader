<Window x:Class="LinuxDriveReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LinuxDriveReader"
        Title="Linux Drive Reader" Height="700" Width="1150" MinHeight="400" MinWidth="700"
        AllowDrop="True" Drop="Window_Drop">
    <DockPanel>
        <Border x:Name="AdminBanner" DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E5D18A" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="RestartAsAdmin_Click" Content="Restart as administrator" Margin="10,0,0,0"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Windows only lets administrators read disks directly. Restart as administrator to read your Linux disks. Disk image files work without it."/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="Refresh disks" Click="Refresh_Click"/>
                <Button Content="Open disk image…" Click="OpenImage_Click"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,5" BorderBrush="#DDD" BorderThickness="0,1,0,0" Background="#F7F7F7">
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="140" Height="14" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="DiskTree" Grid.Column="0" BorderThickness="0" SelectedItemChanged="DiskTree_SelectedItemChanged" Padding="4">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Padding" Value="2,3"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:DiskItem}" ItemsSource="{Binding Volumes}">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:VolumeItem}" ItemsSource="{Binding Children}">
                        <StackPanel Margin="0,1" Opacity="{Binding Opacity}">
                            <TextBlock Text="{Binding Title}"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type local:NoteItem}">
                        <TextBlock Text="{Binding Text}" Foreground="#A05A00" TextWrapping="Wrap" MaxWidth="260" FontSize="11"/>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E5E5"/>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="BackButton" DockPanel.Dock="Left" Content="← Back" Click="Back_Click" IsEnabled="False"/>
                        <Button x:Name="UpButton" DockPanel.Dock="Left" Content="↑ Up" Click="Up_Click" IsEnabled="False"/>
                        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Copy to Windows…" Click="Save_Click" IsEnabled="False" Margin="6,0,0,0"/>
                        <TextBox x:Name="PathBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,2" Background="#FAFAFA"/>
                    </DockPanel>
                </Border>
                <Border x:Name="WarningBar" DockPanel.Dock="Top" Background="#FDE7E9" Padding="10,6" Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap"/>
                </Border>
                <Grid>
                    <ListView x:Name="FileList" BorderThickness="0" MouseDoubleClick="FileList_MouseDoubleClick"
                              KeyDown="FileList_KeyDown" SelectionChanged="FileList_SelectionChanged"
                              GridViewColumnHeader.Click="FileList_HeaderClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="OpenSelected_Click"/>
                                <MenuItem Header="Copy to Windows…" Click="Save_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding IconBrush}" Margin="0,2,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding SizeText}" TextAlignment="Right" Width="76"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}"/>
                                <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding TypeText}"/>
                                <GridViewColumn Header="Permissions" Width="95" DisplayMemberBinding="{Binding Permissions}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="EmptyHint" Text="Choose a Linux partition on the left, or open a disk image file."
                               Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
